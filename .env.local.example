# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── CoinGecko (optional) ─────────────────────────────────────────────────────
# Free tier works without a key — ~30 calls/min rate limit
# Pro key removes rate limits: https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=

# ─── Cron job security (optional) ────────────────────────────────────────────
# Set a random secret string. Pass as Bearer token when hitting /api/recommendations POST
CRON_SECRET=your-random-secret-here

# ─── OpenAI (Phase 2 — AI explanations) ──────────────────────────────────────
# Leave blank for MVP — deterministic reasoning is used instead
OPENAI_API_KEY=
